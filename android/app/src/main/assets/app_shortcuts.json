 "skills": [
  {
   "app": "com.whatsapp",
   "category": "messaging",
   "action": "send_message",
   "name": "WhatsApp: send message",
   "risk": "HIGH",
   "description": "Send a WhatsApp message (direct chat link; needs Contacts)",
   "patterns": [
    "send {message_text} to {contact_name} on whatsapp",
    "send a whatsapp message to {contact_name} saying {message_text}",
    "send whatsapp to {contact_name} saying {message_text}",
    "message {contact_name} on whatsapp saying {message_text}",
    "message {contact_name} on whatsapp {message_text}",
    "tell {contact_name} on whatsapp {message_text}",
    "whatsapp {contact_name} saying {message_text}"
   ],
   "steps": [
    {
     "action": "open_link",
     "pkg": "com.whatsapp",
     "uri": "https://wa.me/{contact_number_digits}?text={message_text}"
    },
    {
     "action": "wait",
     "wait_ms": 2500
    },
    {
     "action": "find_element",
     "viewId": "com.whatsapp:id/entry"
    },
    {
     "action": "confirm_send",
     "message": "Send \"{message_text}\" to {contact_name} on WhatsApp?",
     "risk": "HIGH"
    },
    {
     "action": "tap",
     "viewId": "com.whatsapp:id/send",
     "text": "Send"
    },
    {
     "action": "verify",
     "pkg": "com.whatsapp",
     "text": "{message_text}"
    }
   ]
  },
  {
   "app": "com.whatsapp",
   "category": "messaging",
   "action": "send_message_search",
