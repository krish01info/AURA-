     "input_text": "{contact_name}",
     "text": "Search"
    },
    {
     "action": "wait",
     "wait_ms": 1500
    },
    {
     "action": "tap",
     "text": "{contact_name}"
    },
    {
     "action": "find_element",
     "viewId": "com.whatsapp:id/entry"
    },
    {
     "action": "type",
     "input_text": "{message_text}",
     "viewId": "com.whatsapp:id/entry"
    },
    {
     "action": "confirm_send",
     "message": "Send \"{message_text}\" to {contact_name} on WhatsApp?",
     "risk": "HIGH"
    },
    {
     "action": "tap",
     "viewId": "com.whatsapp:id/send"
    },
    {
     "action": "verify",
     "pkg": "com.whatsapp",
     "text": "{message_text}"
    }
   ]
  },
