# AURA — Environment Variables
# Copy this file to `android/local.properties` and fill in your keys.
# NEVER commit your real keys — local.properties is in .gitignore.

# ── LLM API Keys ──────────────────────────────────────────────────
# Primary LLM: Groq (free — 14,400 req/day, 300+ tok/s)
# Get yours at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Phase 2b — Skill Store (add when ready) ───────────────────────
# Supabase (free tier) — shared cloud skill store
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Phase 3+ — Optional (add when ready) ─────────────────────────
# Firebase (crash reporting — can be skipped for MVP)
# No key needed — uses google-services.json downloaded from Firebase console

# ── Android SDK (auto-filled by Android Studio) ───────────────────
# sdk.dir=/Users/yourname/Library/Android/sdk
