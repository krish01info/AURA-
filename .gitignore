# ── IDE / editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ── Build output / compiler scratch ──────────────────────────────────────────
build/
.gradle/
.kotlin/
captures/

# ── Secrets — never commit ───────────────────────────────────────────────────
local.properties
google-services.json
*.keystore
*.jks
.env
.env.*
!.env.example

# ── AI assistant notes and local settings (agents/repo_rules.md §8) ─────────
# .claude/settings.json and .claude/skills/ are shared and stay tracked; the rest of .claude/ is local.
.claude/*
!.claude/settings.json
!.claude/skills/
# Root only: android/.../com/aura/memory/ is source code and must stay tracked.
/HANDOFF.md
/memory/
